# Storyboard generation (pnpm generate:storyboards). Copy to .env.local, which is gitignored. Never commit keys.

# Which provider to use: "google" (default, Gemini free tier works) or "anthropic".
AI_PROVIDER=google

# Optional model override. Defaults: gemini-3.8-flash (google), claude-opus-5-5 (anthropic).
# AI_MODEL=

# Key for the provider you chose.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Optional pause between model requests in milliseconds (default 10000), for free-tier per-minute limits.
# GENERATION_DELAY_MS=10000

# Optional per-request timeout in milliseconds (default 120000). A request that times out is retried with backoff.
# GENERATION_TIMEOUT_MS=120000
