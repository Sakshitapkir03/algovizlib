# Storyboard generation (pnpm generate:storyboards). Copy to .env.local, which is gitignored. Never commit keys.

# Which provider to use: "google" (default, Gemini free tier works) or "anthropic".
AI_PROVIDER=google

# Optional model override. Defaults: gemini-3.8-flash (google), claude-opus-5-5 (anthropic).
# AI_MODEL=

# Key for the provider you chose.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Optional pause between model requests in milliseconds (default 10000), for free-tier per-minute limits.
# GENERATION_DELAY_MS=10000

# Optional per-request timeout in milliseconds (default 120000). A request that times out is retried with backoff.
# GENERATION_TIMEOUT_MS=120000

# Narration (pnpm generate:narration). ElevenLabs text-to-speech; the free plan works (~20k characters/month on Flash).
ELEVENLABS_API_KEY=

# Optional voice override. Default: "Sarah" (EXAVITQu4vr4xnSDxMaL), a default voice the free plan can use via the API.
# ELEVENLABS_VOICE_ID=

# Optional model override. Default: eleven_flash_v2_5 (cheapest per character; the Turbo models are deprecated).
# ELEVENLABS_MODEL_ID=

# Optional pause between requests (default 500) and per-request timeout (default 60000), in milliseconds.
# ELEVENLABS_DELAY_MS=500
# ELEVENLABS_TIMEOUT_MS=60000
# Stitching narration clips into one track needs ffmpeg; set this if it isn't on PATH (not needed to build).
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ---------------------------------------------------------------------------------------------------------------
# Accounts (Auth.js + Postgres). Locally: .env.local. In production: Vercel → Settings → Environment Variables.
# See "Accounts" in CLAUDE.md for the setup steps.

# Postgres. Locally, e.g. postgresql://<you>@localhost:5432/algovizlib_dev. On Vercel: Neon's POOLED connection string.
DATABASE_URL=
# Neon's DIRECT (unpooled) connection string, used only by `pnpm db:deploy` / `prisma migrate`. Optional locally.
# DATABASE_URL_UNPOOLED=
# A separate database for the integration tests (they skip without it). Never the dev or production database.
# DATABASE_URL_TEST=postgresql://<you>@localhost:5432/algovizlib_test

# Signs and encrypts session cookies. Generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=
# Locally with `pnpm start` (production build), Auth.js needs this; Vercel sets the equivalent itself.
# AUTH_TRUST_HOST=true

# GitHub OAuth app (one for localhost, one for production: each has a single callback URL).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client (one client can list both callback URLs).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email + password sign-in. Default: on locally, off in production. Turn it on in production only once Resend has a
# verified sending domain (below), or verification and reset emails won't reach anyone but you.
# AUTH_EMAIL_PASSWORD_ENABLED=true

# Where links in emails point. Default: Vercel's production domain, else http://localhost:3000.
# APP_URL=https://algovizlib.vercel.app

# Resend (only needed when email + password is on). Without them, links are printed to the server console
# (development only: production refuses to run email + password without them).
# RESEND_API_KEY=
# EMAIL_FROM="algovizlib <hello@your-verified-domain.com>"
