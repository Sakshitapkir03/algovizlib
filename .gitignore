# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: never commit secrets (API keys for Claude / ElevenLabs later)
.env
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generation cache (scripts/generate-storyboards.ts)
.cache/

# Prisma client (generated by `prisma generate` on install)
/src/generated/

# Claude Code worktrees (a full checkout each: never commit, lint, or typecheck them)
.claude/worktrees/
